{
  "info": {
    "name": "JLer Android — existing backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "examId",
      "value": "lap_trinh_python"
    },
    {
      "key": "attemptId",
      "value": ""
    },
    {
      "key": "schoolId",
      "value": "hubt"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "JLer"
          }
        ],
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Login student",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "JLer"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentCode\": \"YOUR_STUDENT_CODE\",\n  \"password\": \"YOUR_PASSWORD\",\n  \"role\": \"STUDENT\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code===200)pm.collectionVariables.set(\"accessToken\",pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Refresh (Postman cookie jar)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/refresh",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "JLer"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code===200)pm.collectionVariables.set(\"accessToken\",pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Profile",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/auth/me",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "JLer"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Subjects",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/mobile/subjects",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "JLer"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Study",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/mobile/subjects/{{examId}}/study?page=0&size=30",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "JLer"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Start native attempt",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/mobile/attempts",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "JLer"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subjectId\": \"{{examId}}\",\n  \"count\": 10,\n  \"minutes\": 30,\n  \"shuffle\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code===200)pm.collectionVariables.set(\"attemptId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Save answers",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/mobile/attempts/{{attemptId}}/answers",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "JLer"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"answers\": {\n    \"0\": 0\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Resume",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/mobile/attempts/{{attemptId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "JLer"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Submit (edit full answer map)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/mobile/attempts/{{attemptId}}/submit",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "JLer"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"answers\": {\n    \"0\": 0\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Native history",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/mobile/attempts?page=0",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "JLer"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Same history for web",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/history",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "JLer"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/logout",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "JLer"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Schools (public)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/public/schools",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Majors of selected school",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/public/schools/{{schoolId}}/majors",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Subjects of selected school",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/public/schools/{{schoolId}}/subjects",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Search subjects within school",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/public/schools/{{schoolId}}/subjects?majorId=cntt&keyword=java",
        "auth": {
          "type": "noauth"
        }
      }
    }
  ]
}